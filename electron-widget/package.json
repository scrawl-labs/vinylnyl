{
  "name": "vinylnyl-widget",
  "version": "1.1.0",
  "description": "지금 재생 중인 음악을 보여주는 레코드판 위젯 (macOS / Windows / Linux)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --universal",
    "dist:mac": "electron-builder --mac dmg --universal",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:app": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.vinylnyl.widget",
    "productName": "Vinylnyl",
    "asar": false,
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "Vinylnyl.dmg"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Vinylnyl-Setup.exe",
      "oneClick": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "Vinylnyl.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
